# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# claude code — ignore local settings but track skills
.claude/settings.local.json
.claude/handoffs/

# nightly bot output (VM-local)
/bot/reports/
/bot/logs/
/bot/FOCUS.md

# typescript
*.tsbuildinfo
next-env.d.ts
tests/.auth/
.env.bot.local
tests/e2e/.results/
tests/e2e/.report/
tests/smoke/.results/

# Playwright MCP scratch output — page snapshots, console logs, screenshots.
# This was ignored only by the PARENT Claude-EA .gitignore, which the VM's
# standalone clone of this repo never sees. It had been accumulating there
# untracked since 2026-07-09: 3,911 files, 62MB, and screenshots of signed-in
# pages showing real account data.
.playwright-mcp/

# Exported account backups. One of these files is an ENTIRE account — every RO,
# VIN, mileage, pay rate and dollar figure — and downloading one into the repo
# directory is the normal way to test import. Six were found loose on the VM.
# Untracked is not the same as ignored: `git add -A` would have published them.
flat-rate-backup-*.json
