# Copy to .env.local (local dev) or .env (production Docker) and fill in values.
#
# Phase 1 (local dev): point at your local Supabase stack started via `npx supabase start`.
#   Run `npx supabase status -o env` to see the current values.
# Phase 2 (self-hosted homelab): point at your self-hosted Supabase Kong API gateway.
#   NEXT_PUBLIC_SUPABASE_URL=https://api.slimelab.cc
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<ANON_KEY from Supabase .env>
# Phase 3 (cloud): point at your Supabase cloud project.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# --- Rate limiting (src/lib/rate-limit.ts) -----------------------------------
# OPTIONAL, and deliberately unset in Phases 1-2.
#
# Rate limiting is ALWAYS ON. Unset, it uses a process-local sliding window,
# which is correct while FRT runs as one Next.js process in one container.
#
# Set BOTH of these and it switches to Upstash Redis automatically, with no code
# change. That becomes REQUIRED at the Phase 3 cloud cutover: on Vercel every
# request can land on a fresh instance, so a process-local counter would count
# to one forever and every limit in the app would be decorative.
#
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
