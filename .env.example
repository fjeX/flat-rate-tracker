# Copy to .env.local (local dev) or .env (production Docker) and fill in values.
#
# LOCAL DEV (.env.local) → the STAGING project. `next dev` refuses any other
# database except a local `npx supabase start` stack (127.0.0.1:54321); see
# src/lib/supabase/environments.ts. The publishable key is public (it ships in
# the browser bundle), so it's written here in full.
#
# PRODUCTION (.env on the VM) → https://api.slimelab.cc + the self-hosted ANON_KEY.
# Builds are not checked by the dev guard.

NEXT_PUBLIC_SUPABASE_URL=https://dazwengljgvpbmeovuiy.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_IZZBDlO_bG5RzfxtlNEsRw_i8H7-9Fy

# --- Rate limiting (src/lib/rate-limit.ts) -----------------------------------
# OPTIONAL, and deliberately unset in Phases 1-2.
#
# Rate limiting is ALWAYS ON. Unset, it uses a process-local sliding window,
# which is correct while FRT runs as one Next.js process in one container.
#
# Set BOTH of these and it switches to Upstash Redis automatically, with no code
# change. That becomes REQUIRED at the Phase 3 cloud cutover: on Vercel every
# request can land on a fresh instance, so a process-local counter would count
# to one forever and every limit in the app would be decorative.
#
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Sentry error tracking (launch plan step 3) -------------------------------
# PRODUCTION (.env on the VM) only. Leave unset in .env.local: with no DSN the
# SDK is off, so local dev and CI never report. (To test Sentry locally, set
# NEXT_PUBLIC_SENTRY_DSN + NEXT_PUBLIC_SENTRY_ENVIRONMENT=development on the
# command line for one run.)
# Values: projects/flat-rate-tracker/.env.observability.local on the PC.
#   NEXT_PUBLIC_SENTRY_DSN  public by design (baked into the bundle; rebuild to change)
#   SENTRY_ORG / SENTRY_PROJECT  flat-rate-ledger / frl
#   SENTRY_AUTH_TOKEN  SECRET. Source-map upload only; reaches the Docker build as
#                      a BuildKit secret, never an image layer. Also used by
#                      deploy.sh to mark the release deployed.
# SENTRY_RELEASE is not set here: deploy.sh exports the git SHA per build.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
